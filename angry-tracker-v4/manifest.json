{
  "manifest_version": 3,
  "name": "Angry Tracker v4",
  "version": "4.5.7",
  "description": "Angry Tracker/Fresh - SSE",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://axiom.trade/*",
    "http://axiom.trade/*",
    "https://trader.bot.nu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*",
        "http://axiom.trade/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://axiom.trade/*",
        "http://axiom.trade/*"
      ],
      "js": [
        "ap_channel.js",
        "meme_scanner.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "sidebar.css",
        "sidebar.js",
        "icons.js",
        "botapi.js",
        "icon.png",
        "Sortable.min.js",
        "shared/footer.js"
      ],
      "matches": [
        "https://axiom.trade/*",
        "http://axiom.trade/*"
      ]
    }
  ],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "24": "icon.png",
      "32": "icon.png"
    },
    "default_title": "Angry Tracker"
  }
}